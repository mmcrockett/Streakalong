# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Example of extracting secrets from 1password (or another compatible pw manager)
# SECRETS=$(kamal secrets fetch --adapter 1password --account your-account --from Vault/Item KAMAL_REGISTRY_PASSWORD RAILS_MASTER_KEY)
# KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
# RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY ${SECRETS})

# Example of extracting secrets from Rails credentials
# KAMAL_REGISTRY_PASSWORD=$(rails credentials:fetch kamal.registry_password)

# GHCR auth. Locally, reuses your gh CLI login. In CI, GITHUB_TOKEN is
# already set by the runner -- no gh CLI needed/available there.
GITHUB_TOKEN=$([ -n "$GITHUB_TOKEN" ] && echo "$GITHUB_TOKEN" || gh config get -h github.com oauth_token)
KAMAL_REGISTRY_PASSWORD=$GITHUB_TOKEN

# config/credentials/production.yml.enc holds the real production
# credentials (mysql_password); config/credentials/production.key is its
# master key (gitignored, lives only on disk/CI secrets, never committed).
# Rails prefers this per-environment file over the generic
# config/credentials.yml.enc for RAILS_ENV=production, so this is the key
# that matters for a real `kamal deploy` -- the container decrypts it on
# boot. deploy.yml passes it via the RAILS_MASTER_KEY secret.
RAILS_MASTER_KEY=$([ -n "$RAILS_MASTER_KEY" ] && echo "$RAILS_MASTER_KEY" || cat config/credentials/production.key 2>/dev/null || echo "unused-in-ci-build-only")
